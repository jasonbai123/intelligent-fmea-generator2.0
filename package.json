{
  "name": "intelligent-fmea-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://intelligent-fmea-generator2.pages.dev",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:pages": "npm run build && npx wrangler pages deploy docs --project-name=intelligent-fmea-generator",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test tests/e2e/mobile.spec.ts",
    "test:e2e:fmea": "playwright test tests/e2e/fmea-generation.spec.ts",
    "test:network": "playwright test tests/e2e/network.spec.ts",
    "test:api": "vitest run tests/api",
    "test:api:auth": "vitest run tests/api/auth-api.test.ts",
    "test:api:ai": "vitest run tests/api/ai-api.test.ts",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:api",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test:all",
    "test:run": "bash scripts/test-all.sh",
    "test:quick": "bash scripts/test-all.sh quick",
    "test:fix": "node tests/runTests.js --fix",
    "test:auto": "node tests/autoTestAndFix.js",
    "test:auto:fix": "node tests/autoTestAndFix.js --retries=3",
    "test:auto:check": "node tests/autoTestAndFix.js --no-fix",
    "test:verify": "node tests/autoTestAndFix.js && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "exceljs": "4.4.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "happy-dom": "^15.0.0",
    "jsdom": "^25.0.0",
    "terser": "^5.44.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.0"
  }
}
